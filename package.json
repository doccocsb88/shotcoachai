{
  "name": "shotcoach-ai",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "metro start --port 8081",
    "bundle:ios": "bash -c 'set -a; [ -f .env ] && . ./.env; set +a; react-native bundle --entry-file index.ts --platform ios --dev false --bundle-output ios/AIPhotoCoach/main.jsbundle --assets-dest ios/AIPhotoCoach'",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "generate:poses": "node scripts/generate-pose-catalog.mjs",
    "convert:poses:webp": "node scripts/convert-pose-assets-to-webp.mjs",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-firebase/analytics": "^23.4.1",
    "@react-native-firebase/app": "^23.4.1",
    "@react-native-firebase/app-check": "^23.4.1",
    "@react-native-firebase/auth": "^23.4.1",
    "@react-navigation/native": "^7.3.17",
    "@react-navigation/native-stack": "^7.18.9",
    "babel-preset-expo": "~54.0.10",
    "expo": "~54.0.37",
    "expo-asset": "~12.0.13",
    "expo-blur": "~15.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-camera": "~17.0.10",
    "expo-file-system": "~19.0.24",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-media-library": "~18.2.1",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-tracking-transparency": "~6.0.8",
    "phosphor-react-native": "^3.0.6",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-encrypted-storage": "^4.0.3",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-google-mobile-ads": "^15.7.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-view-shot": "4.0.3",
    "react-native-webview": "13.15.0",
    "zustand": "5.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@react-native-community/cli": "^20.2.0",
    "@react-native-community/cli-platform-android": "^20.2.0",
    "@react-native-community/cli-platform-ios": "^20.2.0",
    "@types/react": "~19.1.10",
    "jscodeshift": "^17.4.0",
    "patch-package": "^8.0.1",
    "postinstall-postinstall": "^2.1.0",
    "typescript": "~5.9.2"
  }
}
