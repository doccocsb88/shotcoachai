# web-demo (Vite — optional; defaults match Expo)
VITE_OPENAI_MODEL=gpt-4.1-mini
VITE_OPENAI_IMAGE_MODEL=gpt-image-1.5
VITE_OPENAI_IMAGE_SIZE=1024x1536
# web-demo: Responses API image_generation với action edit (không dùng /v1/images/generations)
VITE_OPENAI_IMAGE_EDIT_MODEL=gpt-4.1
VITE_OPENAI_IMAGE_EDIT_QUALITY=low
EXPO_PUBLIC_OPENAI_MODEL=gpt-4.1-mini
EXPO_PUBLIC_OPENAI_IMAGE_MODEL=gpt-image-1.5
EXPO_PUBLIC_OPENAI_IMAGE_SIZE=1024x1536
# low | medium | high — used with GPT Image models on /v1/images/edits
EXPO_PUBLIC_OPENAI_IMAGE_EDIT_QUALITY=medium
EXPO_PUBLIC_DEBUG_ERRORS=0
EXPO_PUBLIC_DEBUG_OPENAI_FLOW=0
EXPO_PUBLIC_ANALYSIS_PROVIDER=mock
EXPO_PUBLIC_TESTING_MOCKUP_MODE=success
EXPO_PUBLIC_SHOTCOACH_API_URL=https://shotcoachai-backend.vercel.app
# Firebase Console > App Check > Manage debug tokens (one token per platform)
EXPO_PUBLIC_FIREBASE_APP_CHECK_DEBUG_TOKEN_ANDROID=
EXPO_PUBLIC_FIREBASE_APP_CHECK_DEBUG_TOKEN_IOS=
