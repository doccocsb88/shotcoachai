{
  "expo": {
    "name": "AI Photo Coach",
    "slug": "shotcoach-ai",
    "version": "0.1.2",
    "icon": "./assets/app-icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "jsEngine": "hermes",
